{
  "SessionStart": [
    {
      "matcher": "startup|resume|clear|compact",
      "hooks": [
        {
          "type": "command",
          "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/session-state.mjs\"",
          "commandWindows": "node \"$((git rev-parse --show-toplevel).Trim())\\.codex\\hooks\\session-state.mjs\""
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash|apply_patch",
      "hooks": [
        {
          "type": "command",
          "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/privacy-block.mjs\"",
          "commandWindows": "node \"$((git rev-parse --show-toplevel).Trim())\\.codex\\hooks\\privacy-block.mjs\""
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/ship-gate.mjs\"",
          "commandWindows": "node \"$((git rev-parse --show-toplevel).Trim())\\.codex\\hooks\\ship-gate.mjs\""
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Bash|apply_patch",
      "hooks": [
        {
          "type": "command",
          "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/monitoring.mjs\"",
          "commandWindows": "node \"$((git rev-parse --show-toplevel).Trim())\\.codex\\hooks\\monitoring.mjs\""
        }
      ]
    }
  ]
}
